# אל תעלה קובץ עם ערכים אמיתיים ל-GitHub! זה רק לדוגמה.
# ב-Railway/Render מגדירים את המשתנים האלה בפאנל "Variables", לא כקובץ.

TELEGRAM_BOT_TOKEN=123456:ABC-DEF...        # מ-BotFather
ANTHROPIC_API_KEY=sk-ant-...                # ממסוף console.anthropic.com
GOOGLE_SHEET_ID=1AbCдEf...                  # מה-URL של הגיליון: /d/<SHEET_ID>/edit
GOOGLE_WORKSHEET_NAME=Sheet1                # שם הטאב בגיליון שבו moneyman כותב
GOOGLE_CREDENTIALS_JSON={"type": "service_account", ...}   # כל תוכן קובץ ה-JSON של ה-service account, כמחרוזת אחת
